# BasuraTrack Environment Variables
# Copy this to .env and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Semaphore SMS (Philippine SMS API) — used in Edge Functions only
# Get your API key at https://semaphore.co
SEMAPHORE_API_KEY=your-semaphore-api-key
SEMAPHORE_SENDER_NAME=BasuraTrack

# Resend (email fallback) — used in Edge Functions only
# Get your API key at https://resend.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@basuratrack.app

# OpenWeather API (optional) — used in Edge Functions only
# Get your API key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key

# Barangay coordinates (Butuan City defaults)
VITE_BARANGAY_LAT=8.9475
VITE_BARANGAY_LNG=125.5406
VITE_BARANGAY_NAME=Butuan City
